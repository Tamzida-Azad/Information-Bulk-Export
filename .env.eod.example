# Copy to .env and fill with YOUR private values. Never commit .env.

# Optional password login (leave blank for SSO / manual save-auth)
SLACK_EMAIL=you@example.com
SLACK_PASSWORD=replace-me

# Slack workspace
SLACK_WORKSPACE_URL=https://your-workspace.slack.com/
SLACK_SIGN_IN_URL=https://your-workspace.slack.com/sign_in_with_password
SLACK_TEAM_ID=T0000000000
SLACK_DISPLAY_NAME=Your Display Name
SLACK_MEMBER_ID=U0000000000

# Source channel A (where you post task updates)
SLACK_SOURCE_A_NAME=project-updates
SLACK_SOURCE_A_ID=C0000000001

# Source channel B (optional second source)
SLACK_SOURCE_B_NAME=team-internal
SLACK_SOURCE_B_ID=

# Destination EOD channel
SLACK_EOD_CHANNEL_NAME=eod-updates
SLACK_EOD_CHANNEL_ID=C0000000002

# Project-management task link host (no https://)
TASK_URL_HOST=pm.example.com

# Scheduling / date logic
EOD_TIMEZONE=UTC
EOD_HEADED=1
EOD_DRY_RUN=0

# Posting retries: up to 10 attempts, 10 minutes between failures
EOD_MAX_RETRIES=10
EOD_RETRY_DELAY_MS=600000
